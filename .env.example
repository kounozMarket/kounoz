# WooCommerce REST API (D-27) — server-side only, never NEXT_PUBLIC_.
# WooCommerce → Settings → Advanced → REST API → Read/Write key.
WOO_URL=https://admin.konouzmarket.com
WOO_CONSUMER_KEY=
WOO_CONSUMER_SECRET=

# Floating WhatsApp button — international format, digits only (e.g. 2126XXXXXXXX). Not provided yet (Q-05).
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Maintenance mode (D-26) — read at request time by src/proxy.ts.
# "off" = site live. Unset or anything else = maintenance page (HTTP 503) for everyone.
MAINTENANCE_MODE=
# Secret for previewing the real site during maintenance: open https://konouzmarket.com/?preview=<token>
# At least 12 characters. Leave empty to disable previews.
MAINTENANCE_BYPASS_TOKEN=
